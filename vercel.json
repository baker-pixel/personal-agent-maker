{
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" },
        { "key": "Service-Worker-Allowed", "value": "/" }
      ]
    },
    {
      "source": "/workbox-:hash.js",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/normy-siri-shortcut.txt", "destination": "/normy-siri-shortcut.txt" },
    { "source": "/((?!.*\\.[a-zA-Z0-9]{1,5}$).*)", "destination": "/index.html" }
  ]
}
